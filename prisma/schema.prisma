generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BrokerResponse {
  id              String      @id @default(cuid())
  brokerName      String
  brokerEmail     String
  responseContent String
  tag             String
  tier            String?
  status          String      @default("OPEN")
  assignedTo      String?
  website         String?
  jurisdiction    String?
  category        String?
  notes           String?
  // Set only from the external classification pipeline's ingest payload
  // (see app/api/ingest) — this app never runs the holding-reply detection
  // itself, it just renders the flag the classifier already computed.
  isHoldingReply  Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  actions         ActionLog[]
}

model ActionLog {
  id           String         @id @default(cuid())
  responseId   String
  response     BrokerResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  type         String
  assignedTo   String?
  emailTo      String?
  emailSubject String?
  emailBody    String?
  note         String?
  createdAt    DateTime       @default(now())
}

// Legal workbook: reference library of data-protection law clauses per
// jurisdiction, used by legal counsel to back replies to brokers with
// citations. Content is produced by an LLM (see lib/legal-ai.ts) — the
// aiGenerated/verified/lastCheckedAt fields exist so that placeholder data
// seeded today and real model output wired in later share one shape.
model LawRegime {
  id            String      @id @default(cuid())
  country       String
  state         String?
  name          String
  description   String?
  sourceModel   String?
  aiGenerated   Boolean     @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  clauses       LawClause[]
}

model LawClause {
  id             String             @id @default(cuid())
  regimeId       String
  regime         LawRegime          @relation(fields: [regimeId], references: [id], onDelete: Cascade)
  category       String
  title          String
  citation       String
  text           String
  sourceUrl      String?
  verified       Boolean            @default(false)
  aiGenerated    Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  pendingChanges PendingLawChange[]
}

// A proposed update to a clause, created by a recheck, sitting in front of
// the clause until someone accepts or rejects it — the clause itself never
// changes until that happens.
model PendingLawChange {
  id               String    @id @default(cuid())
  clauseId         String
  clause           LawClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  proposedTitle    String?
  proposedCitation String?
  proposedText     String
  changeSummary    String
  status           String    @default("PENDING")
  createdAt        DateTime  @default(now())
  reviewedAt       DateTime?
}

// A broker non-response enforcement case. applicableRegime/responseDeadlineDate/
// filingAuthority/complaintUrl/maxFine are always derived from userCountry+userState
// (never brokerCountry) via lib/jurisdiction-map.ts — see lib/case-tracker.ts for the
// derivation and stage-transition rules that keep this record consistent.
model Case {
  id                    String    @id @default(cuid())
  userCountry           String
  userState             String?
  brokerName            String
  brokerCountry         String
  removalRequestDate    DateTime
  applicableRegime      String
  responseDeadlineDate  DateTime
  enforcementStage      String    @default("request_sent")
  filingAuthority       String
  complaintUrl          String
  maxFine               String
  jurisdictionConfirmedAt DateTime?
  authorityConfirmedAt    DateTime?
  sourceResponseId       String?
  // Evidence completeness checklist gating closure (US-19/US-21): each item
  // is immutable once confirmed (mirrors jurisdictionConfirmedAt/
  // authorityConfirmedAt above — see lib/case-tracker.ts assertConfirmable).
  // retentionException additionally carries the confirming note itself,
  // since "no exception applies" is a valid confirmed value, not an absence.
  evidenceRequestConfirmedAt   DateTime?
  evidenceIdentityConfirmedAt  DateTime?
  evidenceSystemsConfirmedAt   DateTime?
  evidenceReplyConfirmedAt     DateTime?
  evidenceRetentionConfirmedAt DateTime?
  evidenceRetentionNote        String?
  // Case closure is blocked until all five evidence items above are
  // confirmed — see lib/case-tracker.ts assertCanClose(). Independent of
  // enforcementStage, which tracks the enforcement pipeline, not closure.
  closedAt               DateTime?
  // Draft reply workflow (US-13/US-15/US-20/US-25). draftReply is the
  // editable text; draftInsertions is a JSON-encoded array of
  // { id, source, label, sourceCaseId?, text } logging which blocks came
  // from a snippet insertion and where from (see lib/draft-tracker.ts) — an
  // approximation of "source per sentence" scoped to what the UI actually
  // controls (inserts), since there's no real drafting/parsing engine here.
  // approvedDraftText is a snapshot, not a flag: filing (complaint_filed)
  // requires it to exist AND equal the current draftReply — see
  // lib/case-tracker.ts assertDraftApprovedForFiling(). Unlike
  // jurisdictionConfirmedAt/authorityConfirmedAt, this is NOT immutable —
  // editing the draft after approval is expected to require re-approval.
  draftReply             String?
  draftInsertions        String?
  approvedDraftText      String?
  approvedBy             String?
  approvedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  actionLogs            CaseActionLog[]
}

// Append-only history of what happened on a case: enforcement-stage advances
// (type STAGE_ADVANCED, with `stage` set to the EnforcementStage reached —
// reuses STAGE_CONFIG in lib/constants.ts for label/icon, no separate config
// needed) plus the two confirmation events (JURISDICTION_CONFIRMED /
// AUTHORITY_CONFIRMED, `stage` null). Mirrors ActionLog's role for
// BrokerResponse, scoped to Case instead.
model CaseActionLog {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String
  stage     String?
  note      String?
  createdAt DateTime @default(now())
}
