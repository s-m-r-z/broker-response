# Database (SQLite — no setup required)
DATABASE_URL="file:./dev.db"

# Gmail SMTP (use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@yourcompany.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-email@yourcompany.com

# Simple auth — both required for login to work (see proxy.ts)
AUTH_PASSWORD=your-dashboard-password
AUTH_SECRET=some-random-session-value
